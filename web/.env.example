# "dev" shows an email box instead of Google (backend must also run AUTH_MODE=dev).
VITE_AUTH_MODE=dev
# Empty = same origin (Vite proxies /api to the local worker).
VITE_API_BASE=
# Firebase web config (same project as the Writing Bank app) for VITE_AUTH_MODE=firebase.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=hyperdatalab-writing-bank.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=hyperdatalab-writing-bank
VITE_FIREBASE_APP_ID=
VITE_ORG_DOMAIN=hyperdatalab.org
