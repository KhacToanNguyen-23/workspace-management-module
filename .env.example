# Local settings for `npm run dev`. Copy to `.env` (never committed) and fill in.
# One file for both halves: the backend reads the plain names, the web app the VITE_ ones.
# Production does not read this file: set the same names as real environment variables
# (backend) and as build arguments (web image).

# ---- Sign-in ---------------------------------------------------------------
# dev = pick a demo account, no real sign-in.  sso = HyperDataLab SSO.
# Both lines must say the same thing.
AUTH_MODE=sso
VITE_AUTH_MODE=sso

# ---- HyperDataLab SSO (only read when the mode is sso) ----------------------
# Register the app in ResearchPulse -> /admin/users -> Connected applications:
#   callback URL  the value of VITE_SSO_CALLBACK_URL below, character for character
#   client type   Confidential
#   scopes        email, profile, hyperdatalab_profile
# then paste the client id (twice) and the secret (shown once) below.
SSO_BASE_URL=https://rpr-grobid-gateway.hpl-storage.workers.dev
VITE_SSO_BASE_URL=https://rpr-grobid-gateway.hpl-storage.workers.dev
SSO_CLIENT_ID=
VITE_SSO_CLIENT_ID=
# Empty for a Public client; a Confidential client's secret goes here (shown once).
SSO_CLIENT_SECRET=
# The callback URL exactly as registered. Empty = <web origin>/auth/callback.
VITE_SSO_CALLBACK_URL=http://localhost:3000
# Hours a sign-in lasts before the user goes through the SSO again.
SSO_SESSION_HOURS=12

# ---- Research projects (ResearchPulse) -------------------------------------
# auto = read the signed-in user's projects from ResearchPulse when signing in through the SSO,
#        sample projects otherwise.  Other values: http | demo | off.
# Nothing to switch on: the project permission is used by itself once ResearchPulse grants it.
PROJECTS_MODE=auto
# Encrypts the users' SSO tokens kept to read their projects: base64 of 32 random bytes, the same
# on every backend instance. Empty = a new random key each start (users sign in again after a
# restart to see projects).
SSO_TOKEN_KEY=

# ---- Accounts ---------------------------------------------------------------
# The first admin. In sso mode this must be an account that can sign in through the SSO.
ADMIN_EMAIL=admin@hyperdatalab.org
VITE_ORG_DOMAIN=hyperdatalab.org

# ---- Addresses --------------------------------------------------------------
# Origin of the web app; the backend only accepts browser calls and SSO callbacks from it.
CORS_ORIGIN=http://localhost:3000
# Empty = same origin (Vite proxies /api to the backend on 8080).
VITE_API_BASE=
